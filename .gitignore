# ---------------------------------------------------------------- что игнорируем
# В репозитории — только то, что написано руками. Всё, что получается в
# процессе сборки, запуска или скачивания, живёт на машине и в git не едет.

# Пакеты и результаты сборки
node_modules/
out/
dist/
release/
launcher/

# Что программа создаёт, работая из исходников
data/
components/
*.log

# Служебные файлы TypeScript (пересобираются сами)
*.tsbuildinfo

# Скачанное и собранное вручную: установщики, архивы, дампы
*.zip
*.exe
*.7z
build-exe.bat
*.rar
tmp/

# Настройки редакторов и системы
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Личное: пароли, токены, локальные переопределения
.env
.env.*
*.local
