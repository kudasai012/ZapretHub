<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Манифест ZapretHub.exe.

  Зачем он вообще нужен: PyInstaller по умолчанию вшивает манифест БЕЗ
  requestedExecutionLevel. Windows воспринимает это как «запускать как
  вызывающий» — и для учётной записи администратора процесс получает
  отфильтрованный (неповышенный) токен. Без повышения winws.exe не
  стартует (ему нужен WinDivert), поэтому диагностика strategies писала
  «нет доступа» по каждой стратегии, хотя пользователь — администратор.

  Одинаково важна и вторая часть: без манифеста Windows считает программу
  не DPI-aware и растягивает её окно, из-за чего интерфейс выглядел
  размытым на экранах с масштабом выше 100%.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="ZapretHub"
      version="1.0.1.0"
      processorArchitecture="*"
  />

  <!-- Права администратора нужны всегда: winws.exe работает через WinDivert. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Windows 8.1 / 10 / 11: без этого система включает режим совместимости. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>

  <!-- Корректный масштаб интерфейса на любом экране. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <disableWindowFiltering xmlns="http://schemas.microsoft.com/SMI/2006/WindowsSettings">true</disableWindowFiltering>
    </windowsSettings>
  </application>
</assembly>
